# ──────────────────────────────────────────────────────────────────────────
# ScamTrap AI — Environment Configuration
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=ScamTrap AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── Networking ───────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Security (REQUIRED — change this!) ───────────────────────────────────
# HMAC key for deterministic PII hashing. Use a long random string.
PII_HMAC_KEY=CHANGE_ME_use_a_real_secret_key_at_least_32_chars

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL recommended. SQLite fallback for local dev.
DATABASE_URL=sqlite:///./scamtrap.db
# DATABASE_URL=postgresql://scamtrap:password@localhost:5432/scamtrap

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI / LLM ─────────────────────────────────────────────────────────────
# Provider: "gemini" or "mock" (offline fallback)
LLM_PROVIDER=mock
GEMINI_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────────
# Provider: "sentence-transformers" or "mock"
EMBEDDING_PROVIDER=mock
